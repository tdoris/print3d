   ],300))*1000)/1000;      
 
//Couple fuselage (2D)
 module Couple(z,r_haut=2,r_bas=2){
  hull(){   
     translate([getNeutralZ(z)-r_haut,getHautY(z)-r_haut,z])circle(r=r_haut);
     translate([getNeutralZ(z)-r_bas,getBasY(z)+r_bas,z])circle(r=r_bas);
     translate([0,getBasY(z),z])square([0.1,getHautY(z)-getBasY(z)]);
     translate([-getNeutralZ(z)+r_haut,getHautY(z)-r_haut,z])circle(r=r_haut);
     translate([-getNeutralZ(z)+r_bas,getBasY(z)+r_bas,z])circle(r=r_bas);
  }      
 }


//=====================================
//   Extrude Fuselage (3D)
//=====================================
 module fuselage(ep_peau=0,startZ=-425,stepZ=3,stopZ=0){
 for (x = [startZ:stepZ:stopZ]){
     echo(x);
 hull(){
   translate([0,0,x])
   linear_extrude(height = 0.01, convexity = 10, twist = 0, $fn=60)offset(r=ep_peau)Couple(x,getRayonHaut(x),getRayonBas(x));
   translate([0,0,((x+stepZ) >= stopZ) ? stopZ : (x+stepZ)])
   linear_extrude(height = 0.01, convexity = 10, twist = 0,$fn=60)offset(r=ep_peau)Couple(((x+stepZ) >= stopZ) ? stopZ : (x+stepZ),getRayonHaut(((x+stepZ) >= stopZ) ? stopZ : (x+stepZ)),getRayonBas(((x+stepZ) >= stopZ) ? stopZ : (x+stepZ)));
  }     
 }    
}

