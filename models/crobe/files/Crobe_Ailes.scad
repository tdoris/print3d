//Coordonnée Y profil Haut fuselage 
function getHautY(pY) = round(lookup(pY,bezier_coordinates([
    [[0.0, 0.0], [0.0, 15.56359], [-64.873901, 30.324712], [-109.99867, 30.324712]],
    [[-109.99867, 30.324712], [-185.97593, 30.324712], [-198.30724, 9.3405763], [-373.52628, 9.3405763]],
    [[-373.52628, 9.3405763], [-373.52628, 9.3405763], [-424.9, 9.3405763], [-425.1, 9.3405763]],
   ],300))*1000)/1000;  

//Coordonnée Y profil Bas fuselage
function getBasY(pY) = round(lookup(pY,bezier_coordinates([
    [[0.0, 0.0], [0.0, -4.016093], [-4.7606454, -10.600841], [-52.207765, -10.600841]],
    [[-52.207765, -10.600841], [-167.57342, -10.600841], [-208.8359, -4.1147892], [-396.40753, -3.6894181]],
    [[-396.40753, -3.6894181], [-408.99026, -3.6608832], [-421.9841, -0.2810404], [-425.1, 3.2]] 
   ],300))*1000)/1000;  

//Coordonnée Z à épaisseur max fuselage (vue de dessus)
function getNeutralZ(pZ) = 100+round(lookup(pZ,bezier_coordinates([  
    [[0.0, -100.0], [0.0, -86.517011], [-64.5185, -88.0], [-88.80598, -88.0]],
    [[-88.80598, -88.0], [-164.3373, -88.0], [-300.46239, -97.0], [-425.0, -97.0]],    
   ],300))*1000)/1000; 
   
//Rayon bas fuselage
 function getRayonBas(pZ) = 100+round(lookup(pZ,bezier_coordinates([
    [[0.0, -100.0], [0.0, -89.982657], [-38.901073, -90.227207], [-88.80598, -90.227207]],
    [[-88.80598, -90.227207], [-138.71089, -90.227207], [-352.5263, -97.481135], [-425.0, -97.0]],
   ],300))*1000)/1000; 
   
//Rayon haut fuselage
 function getRayonHaut(pZ) = 100+round(lookup(pZ,bezier_coordinates([
    [[0.0, -100.0], [0.0, -90.228652], [-33.372926, -94.725124], [-88.80598, -94.725124]],
