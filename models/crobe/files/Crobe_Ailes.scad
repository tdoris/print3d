  translate([0,18,-129])rotate([0,90,0])cylinder(h=190, r=diam_cle/2, center=true,$fn=60);

}

module fixation_ElastiqueAile(diam_fix=2.1){
  translate([13.7+0.6,15,-124])rotate([0,90,98])cylinder(h=10, r=diam_fix/2, center=true,$fn=60); //pion pour élastique   
}

module commandeIncidence_Aile(diam_com=2.1){
  translate([18,18-0.9,-129+39])rotate([0,90,0])cylinder(h=18, r=diam_com/2, center=true,$fn=60);
 
  hull(){
     translate([18-14,18-0.9,-129+39])rotate([0,90,0])cylinder(h=18, r=(diam_com/2)+0.2, center=true,$fn=60);
     translate([18-14,18-5,-129+39])rotate([0,90,0])cylinder(h=18, r=(diam_com/2)+2, center=true,$fn=60);   
  }
}


