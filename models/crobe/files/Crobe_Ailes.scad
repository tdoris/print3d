module SupportAile3D(support_ep=1){
    translate([100,52.5,-192])
    rotate([0,0,-90])//translate([0,297,0])
    difference(){
      union(){
        translate([0,0,-support_ep/2])linear_extrude(height= support_ep, convexity = 10, twist = 0, $fn=40)offset(r=0)
      union(){
        translate([0,297,0])Support_Aile();  
        translate([-0.3,-0.15,0])square([0.4,0.34]); //extrémité
      }
    }
    translate([-6.7,-5,2.5])rotate([0,18.5,0])cube(10);
    mirror([0,0,1])translate([-6.7,-5,2.5])rotate([0,18.5,0])cube(10);

}
}


