module render_output_default() {
  $fn = 20;
}

if (which_model == "") { 
  render_output_default();
}
else {
  default_full_render = 40;

  if (which_model == "Aile1") {
    $fn=default_full_render;
    rotate([90,90,0])Aile_troncon1(-0.4, support);
  }
  if (which_model == "Aile2") {
    $fn=default_full_render;
    rotate([90,-90,0])Aile_troncon2(-0.4, support);
  }
  if (which_model == "Aile1Light") {
    $fn=default_full_render;
    rotate([90,90,0])Aile_troncon1(-0.3, support);
  }
  if (which_model == "Aile2Light") {
    $fn=default_full_render;
    rotate([90,-90,0])Aile_troncon2(-0.3, support);
  }
}

