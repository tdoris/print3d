//   Wing stuff
//=====================================
module demi_Aile2(ep_peau_aile=0, step=20, aile="Full"){
 translate([12,16.5,-129+42])rotate([0,0,0])

 union(){
     
if(aile == "Aile1"){  
  for(x = [0 : step : 140]) {
    //echo(x);
    translate([x-step,getDihedreAile(x-step),-(80-getCoordAile(x-step))])rotate([0,0,0])rotate([-90,0,-90])Trapeze(FAD05_CNC_BF06,   //profil
        getCoordAile(x-step), //corde1
        getCoordAile(x), //corde2
        step, //longueur
        -(80-getCoordAile(x-step))+(80-getCoordAile(x)), // flèche
        0, //vrillage
        atan((getDihedreAile(x)-getDihedreAile(x-step))/step), //dihedre (calcul angle)
        ep_peau_aile);      
    }
}
if(aile == "Aile1" || aile == "Aile2"){  
    for(x = [150 : (step/2) : 250]) {
    //echo(x);
    translate([x-(step/2),getDihedreAile(x-(step/2)),-(80-getCoordAile(x-(step/2)))])rotate([0,0,0])rotate([-90,0,-90])Trapeze(FAD05_CNC_BF06,   //profil
        getCoordAile(x-(step/2)), //corde1
        getCoordAile(x), //corde2
        step/2, //longueur
        -(80-getCoordAile(x-(step/2)))+(80-getCoordAile(x)), // flèche
        0, //vrillage
        atan((getDihedreAile(x)-getDihedreAile(x-(step/2)))/(step/2)), //dihedre (calcul angle)
        ep_peau_aile);      
    }
}
if(aile == "Aile2"){ 
    for(x = [255 : (step/4) : 310]) {
    //echo(x);
    translate([x-(step/4),getDihedreAile(x-(step/4)),-(80-getCoordAile(x-(step/4)))])rotate([0,0,0])rotate([-90,0,-90])Trapeze(FAD05_CNC_BF06,   //profil
        getCoordAile(x-(step/4)), //corde1
        getCoordAile(x), //corde2
        step/4, //longueur
        -(80-getCoordAile(x-(step/4)))+(80-getCoordAile(x)), // flèche
        0, //vrillage
        atan((getDihedreAile(x)-getDihedreAile(x-(step/4)))/(step/4)), //dihedre (calcul angle)
        ep_peau_aile);      
    }    
    for(x = [312 : (step/10) : 320]) {
    //echo(x);
    translate([x-(step/10),getDihedreAile(x-(step/10)),-(80-getCoordAile(x-(step/10)))])rotate([0,0,0])rotate([-90,0,-90])Trapeze(FAD05_CNC_BF06,   //profil
        getCoordAile(x-(step/10)), //corde1
        getCoordAile(x), //corde2
        step/10, //longueur
        -(80-getCoordAile(x-(step/10)))+(80-getCoordAile(x)), // flèche
        0, //vrillage
        atan((getDihedreAile(x)-getDihedreAile(x-(step/10)))/(step/10)), //dihedre (calcul angle)
        ep_peau_aile);      
    }
    for(x = [321 : (step/20) : 330]) {
    //echo(x);
    translate([x-(step/20),getDihedreAile(x-(step/20)),-(80-getCoordAile(x-(step/20)))])rotate([0,0,0])rotate([-90,0,-90])Trapeze(FAD05_CNC_BF06,   //profil
        getCoordAile(x-(step/20)), //corde1
        getCoordAile(x), //corde2
        step/20, //longueur
        -(80-getCoordAile(x-(step/20)))+(80-getCoordAile(x)), // flèche
        0, //vrillage
        atan((getDihedreAile(x)-getDihedreAile(x-(step/20)))/(step/20)), //dihedre (calcul angle)
        ep_peau_aile);      
    }    
    
}   
    
 }
}

module Trapeze(profil,corde1, corde2, longueur, fleche, vrillage , dihedre=0, offsetr){
airfoil=corde1*profil;
tipScale = corde2/corde1;
multmatrix(m = [ [1, 0, tan(-dihedre), 0],
                 		[0, 1, (fleche/longueur), 0],
                        [0, 0, 1, 0],
                        [0, 0, 0,  1]
                        ])
linear_extrude(height = longueur, convexity = 10, twist = vrillage, scale=[tipScale,tipScale], $fn=60)
      rotate([0,0,90])
      offset(r=offsetr)
      polygon(airfoil);
}


