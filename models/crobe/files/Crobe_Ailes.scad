function getDihedreAile(pY) = flatWing ? 0 : round(lookup(-pY,bezier_coordinates([[[0.0, 0.0], [-168.16943, 0.0], [-284.28531, -0.96821853], [-332.0, 16.933334]] ],300))*1000)/1000;

