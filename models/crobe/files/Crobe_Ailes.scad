// Aile troncon1 ******************
module Aile_troncon1(ep_peau=-0.5, support=true){
 difference(){
  union(){
     demi_Aile2(0,20,"Aile1"); //Volume extérieur
     if(support){
         Support3D_Aile1();   
     }
  }
    
  difference(){
    union(){
     difference(){
       intersection(){  
         Decoupe3D_InfillAile();
         demi_Aile2(ep_peau*2,20,"Aile1");  
       }
       cles_Aile(3.1-(ep_peau*2)+0.2);
       commandeIncidence_Aile(2.1-(ep_peau*2)+0.2);
     }
     difference(){
       intersection(){  
         Decoupe3D_AmesAile(ep_peau+0.4); // pour liaison fourreau -> boite à clé
         demi_Aile2(ep_peau*2,20,"Aile1");  
       }
       fixation_ElastiqueAile(2.1-ep_peau*2);
     }
    } 

     Decoupe3D_Troncon2Aile(0.6);
     
     //Wing root cut (internal)
     fuselage(0.6,-170,5,-80);
  }

  Decoupe3D_Troncon2Aile(0);
  
  //Wing root cut (external)
  fuselage(0,-170,5,-80);
  
  #cles_Aile();
  #fixation_ElastiqueAile(2.1);
  #commandeIncidence_Aile(2.1);
 }
} 


   
//
// Aile troncon2 ******************
module Aile_troncon2(ep_peau=-0.5, support=true){
difference(){
  union(){
    demi_Aile2(0,20,"Aile2");
    if(support){
        Support3D_Aile2();
    }
  }  
  difference(){
    union(){
     intersection(){  
        Decoupe3D_InfillAile();
        demi_Aile2(ep_peau*2,20,"Aile2");  
     }
     intersection(){  
        Decoupe3D_AmesAile(ep_peau+0.4);
        demi_Aile2(ep_peau*2,20,"Aile2");  
     }
   }
   Decoupe3D_Troncon1Aile(0.6);
 }

 Decoupe3D_Troncon1Aile(0);
 }
} 

